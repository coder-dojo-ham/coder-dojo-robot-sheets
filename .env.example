# Copy to .env (git-ignored) and set for this machine.
# Where `uv run publish-sheets` copies the built PDFs: the shared "Worksheets" folder of the
# CoderDojo KU Google Drive. A path on this machine (e.g. a mount like /mnt/g/...) or, on WSL when
# the drive is only mounted on Windows, a Windows path (copied via powershell.exe).
GDRIVE_WORKSHEETS_DIR=G:\My Drive\Orionrobots\Coder Dojo KU\Coder Dojo KU Robotics\Worksheets
